{
  "mimeTypes": {
    ".f32": "application/octet-stream",
    ".u8": "application/octet-stream",
    ".onnx": "application/octet-stream",
    ".wasm": "application/wasm",
    ".mjs": "text/javascript"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  },
  "routes": [
    {
      "route": "/mission-vesta",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/mission-vesta/",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
